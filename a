#### frontend/src/App.jsx

```jsx
import { useEffect, useState } from "react";

function App() {
  const [usuarios, setUsuarios] = useState([]);
  const [mensagem, setMensagem] = useState("");

  useEffect(() => {
    // GET /api/usuarios
    fetch("/api/usuarios")
      .then((res) => res.json())
      .then((dados) => setUsuarios(dados));

    // GET /api/saudacao
    fetch("/api/saudacao")
      .then((res) => res.json())
      .then((dados) => setMensagem(dados.mensagem));
  }, []);

  return (
    <div>
      <h1>Front‑end (React)</h1>

      <h2>Saudação do back‑end</h2>
      <p>{mensagem}</p>

      <h2>Usuários</h2>
      <ul>
        {usuarios.map((u) => (
          <li key={u.id}>{u.nome}</li>
        ))}
      </ul>
    </div>
  );
}

export default App;
```

